font-family = ""
theme = "nightfall"
split-divider-color = "#4A4C5F"
cursor-text = "#0E0E15"
font-size = 14
font-feature = "-calt, -liga, -dlig"
adjust-cursor-thickness = 2
macos-titlebar-style = tabs

# Keybindings
keybind = ctrl+v=new_split:right
keybind = ctrl+s=new_split:down

# Shared Neovim/Ghostty navigation outside Neovim.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# Shared Neovim/Ghostty resizing outside Neovim.
keybind = performable:ctrl+left=resize_split:left,50
keybind = performable:ctrl+right=resize_split:right,50
keybind = performable:ctrl+up=resize_split:up,50
keybind = performable:ctrl+down=resize_split:down,50

# The smart-splits backend activates this table in Neovim's pane.
keybind = nvim/
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c

# Forward Ctrl+arrows to smart-splits while Neovim is active.
keybind = nvim/ctrl+left=text:\x1b[1;5D
keybind = nvim/ctrl+right=text:\x1b[1;5C
keybind = nvim/ctrl+up=text:\x1b[1;5A
keybind = nvim/ctrl+down=text:\x1b[1;5B

keybind = ctrl+0=equalize_splits

keybind = global:super+^=toggle_quick_terminal

keybind = super+w=close_tab
keybind = ctrl+q=close_surface

